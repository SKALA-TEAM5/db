# Local PostgreSQL defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safety
POSTGRES_USER=safety_user
POSTGRES_PASSWORD=change-me-postgres-password

# Flyway placeholders / application roles
SERVICE_APP_USER=safety_service_app
SERVICE_APP_PASSWORD=change-me-service-app-password
LAW_APP_USER=safety_law_app
LAW_APP_PASSWORD=change-me-law-app-password
DEV_ADMIN_USER=dev_admin
DEV_ADMIN_PASSWORD=change-me-dev-admin-password

